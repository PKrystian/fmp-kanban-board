{% extends 'base.html.twig' %}

{% block title %}Archive | {{ board.name }} | FMP Kanban{% endblock %}

{% block body %}
    <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_board_index') }}">Boards</a></li>
            <li class="breadcrumb-item text-break"><a href="{{ path('app_board_show', {id: board.id}) }}">{{ board.name }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">Archive</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">Card archive</h1>
            <p class="text-body-secondary mb-0 text-break">{{ board.name }}</p>
        </div>
        <a class="btn btn-outline-primary align-self-start" href="{{ path('app_board_show', {id: board.id}) }}">Back to board</a>
    </div>

    {% if cards %}
        <div class="vstack gap-3">
            {% for card in cards %}
                <article class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex flex-column flex-md-row justify-content-between gap-3">
                            <div>
                                <p class="small text-body-secondary mb-1">
                                    {{ card.key }} | Previous column: {{ card.column.name }} | Archived {{ card.archivedAt|date('M j, Y H:i') }}
                                </p>
                                <h2 class="h5 card-title text-break">{{ card.title }}</h2>
                                {% if card.description %}
                                    <div class="text-body-secondary">
                                        {{ card.description|markdown_to_html }}
                                    </div>
                                {% endif %}
                            </div>
                            <form method="post" action="{{ path('app_card_restore', {boardId: board.id, cardId: card.id}) }}" class="align-self-start">
                                <input type="hidden" name="_token" value="{{ csrf_token('restore_card_' ~ card.id) }}">
                                <button class="btn btn-primary" type="submit">Restore card</button>
                            </form>
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>
    {% else %}
        <div class="card border-0 shadow-sm">
            <div class="card-body py-5 text-center">
                <h2 class="h5">No archived cards</h2>
                <p class="text-body-secondary mb-0">Archived cards from this board will appear here</p>
            </div>
        </div>
    {% endif %}
{% endblock %}
