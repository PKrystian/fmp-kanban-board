{% extends 'base.html.twig' %}

{% block title %}{{ board.name }} | FMP Kanban{% endblock %}

{% block body %}
    <div
        data-kanban-board
        data-board-id="{{ board.id }}"
        data-filters-active="{{ filtersActive ? 'true' : 'false' }}"
        data-card-move-token="{{ csrf_token('move_cards_' ~ board.id) }}"
        data-column-reorder-url="{{ path('app_board_column_reorder', {boardId: board.id}) }}"
        data-column-reorder-token="{{ csrf_token('reorder_columns_' ~ board.id) }}"
    >
    <div data-board-feedback aria-live="polite"></div>

    <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_board_index') }}">Boards</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ board.name }}</li>
        </ol>
    </nav>

    <section aria-labelledby="board-heading">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
            <div>
                <h1 id="board-heading" class="h2 mb-1">{{ board.name }}</h1>
                <p class="text-body-secondary mb-0">Track work as it moves across the board</p>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2 align-self-start align-self-md-center">
                <span class="badge rounded-pill text-bg-light border">
                    {{ board.columns|length }} columns
                </span>
                <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_board_archive', {id: board.id}) }}">Archive</a>
                <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#create-column">
                    Add column
                </button>
            </div>
        </div>

        <form class="card card-body border-0 shadow-sm mb-3" method="get" action="{{ path('app_board_show', {id: board.id}) }}" data-filter-form>
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-4">
                    <label class="form-label" for="filter-search">Search</label>
                    <input class="form-control" id="filter-search" name="q" type="search" value="{{ filters.q }}" placeholder="Title or description">
                </div>
                <div class="col-6 col-lg-2">
                    <label class="form-label" for="filter-type">Type</label>
                    <select class="form-select" id="filter-type" name="type" data-filter-auto-submit>
                        <option value="">All types</option>
                        {% for type in cardTypes %}
                            <option value="{{ type.value }}"{{ filters.type == type.value ? ' selected' }}>{{ type.value|capitalize }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-6 col-lg-2">
                    <label class="form-label" for="filter-priority">Priority</label>
                    <select class="form-select" id="filter-priority" name="priority" data-filter-auto-submit>
                        <option value="">All priorities</option>
                        {% for priority in cardPriorities %}
                            <option value="{{ priority.value }}"{{ filters.priority == priority.value ? ' selected' }}>{{ priority.value|capitalize }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-lg-2">
                    <label class="form-label" for="filter-due">Due date</label>
                    <input class="form-control" id="filter-due" name="due" type="date" value="{{ filters.due }}" data-filter-auto-submit>
                </div>
                <div class="col-12 col-sm-6 col-lg-2">
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary flex-grow-1" type="submit">Apply</button>
                        {% if filtersActive %}
                            <a class="btn btn-outline-secondary" href="{{ path('app_board_show', {id: board.id}) }}">Clear</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </form>

        {% if filtersActive %}
            <div class="alert alert-info py-2" role="status">
                Filters are active. Clear them to change the card or column order
            </div>
        {% endif %}

        <div class="row flex-nowrap overflow-x-auto g-3 pb-3" aria-label="Board columns" data-column-list>
            {% for column in board.columns %}
                {% set visible_card_count = visibleCardCounts[column.id]|default(0) %}
                {% set total_card_count = totalCardCounts[column.id]|default(0) %}
                {% set wip_exceeded = column.wipLimit is not null and total_card_count > column.wipLimit %}
                <article
                    class="col-10 col-sm-6 col-lg-3"
                    data-board-column
                    data-column-id="{{ column.id }}"
                    data-wip-limit="{{ column.wipLimit }}"
                >
                    <div class="card border-0 shadow-sm bg-body-secondary">
                        <div class="card-header bg-transparent border-0 pt-3">
                            <div class="d-flex align-items-start justify-content-between gap-2">
                                <h2 class="h6 fw-semibold mb-0">{{ column.name }}</h2>
                                <span
                                    class="badge rounded-pill {{ wip_exceeded ? 'text-bg-danger' : 'text-bg-light' }}"
                                    data-card-count-badge
                                    aria-label="{{ filtersActive ? visible_card_count ~ ' cards shown, ' : '' }}{{ total_card_count }} cards{{ column.wipLimit is not null ? ', WIP limit ' ~ column.wipLimit : ', no WIP limit' }}{{ wip_exceeded ? ', limit exceeded' }}"
                                >
                                    {% if filtersActive %}{{ visible_card_count }} shown | {% endif %}<span data-card-count>{{ total_card_count }}</span> cards | WIP <span data-wip-limit>{{ column.wipLimit ?? 'No limit' }}</span>
                                </span>
                            </div>
                            <div class="btn-group btn-group-sm mt-3" role="group" aria-label="Manage {{ column.name }} column">
                                <button
                                    class="btn btn-outline-secondary"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#column-content-{{ column.id }}"
                                    data-column-collapse-toggle
                                    aria-expanded="true"
                                    aria-controls="column-content-{{ column.id }}"
                                >Collapse</button>
                                <button class="btn btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#edit-column-{{ column.id }}">Edit</button>
                                <button class="btn btn-outline-danger" type="button" data-bs-toggle="modal" data-bs-target="#delete-column-{{ column.id }}">Delete</button>
                            </div>
                        </div>
                        <div class="collapse show" id="column-content-{{ column.id }}" data-column-collapse>
                        <div class="card-body d-flex flex-column gap-3">
                            <div class="vstack gap-3" data-card-list>
                                {% for card in cardsByColumn[column.id] %}
                                    {% include 'card/_card.html.twig' with {
                                        card: card,
                                        deleteForm: cardDeleteForms[card.id]
                                    } only %}
                                {% else %}
                                    {% include 'card/_empty_column.html.twig' with {
                                        message: filtersActive ? 'No cards match the current filters' : 'No cards in this column'
                                    } only %}
                                {% endfor %}
                            </div>

                            <a
                                class="btn btn-sm btn-outline-primary mt-auto"
                                href="{{ path('app_card_new', {boardId: board.id, columnId: column.id}) }}"
                                data-bs-toggle="collapse"
                                data-bs-target="#quick-create-{{ column.id }}"
                                aria-expanded="false"
                                aria-controls="quick-create-{{ column.id }}"
                            >Add card</a>

                            <div class="collapse" id="quick-create-{{ column.id }}" data-quick-create-container>
                                {% include 'card/_quick_create_form.html.twig' with {
                                    board: board,
                                    column: column,
                                    cardForm: quickCreateForms[column.id]
                                } only %}
                            </div>
                        </div>
                    </div>
                </div>
                </article>
            {% endfor %}
        </div>
    </section>

    <div class="modal fade" id="create-column" tabindex="-1" aria-labelledby="create-column-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="create-column-title">Add column</h2>
                    <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                {{ form_start(columnCreateForm) }}
                    <div class="modal-body">
                        {{ form_row(columnCreateForm.name) }}
                        {{ form_row(columnCreateForm.wipLimit) }}
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                        <button class="btn btn-primary" type="submit">Add column</button>
                    </div>
                {{ form_end(columnCreateForm) }}
            </div>
        </div>
    </div>

    {% for column in board.columns %}
        <div class="modal fade" id="edit-column-{{ column.id }}" tabindex="-1" aria-labelledby="edit-column-title-{{ column.id }}" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="edit-column-title-{{ column.id }}">Edit column</h2>
                        <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    {{ form_start(columnEditForms[column.id]) }}
                        <div class="modal-body">
                            {{ form_row(columnEditForms[column.id].name) }}
                            {{ form_row(columnEditForms[column.id].wipLimit) }}
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                            <button class="btn btn-primary" type="submit">Save changes</button>
                        </div>
                    {{ form_end(columnEditForms[column.id]) }}
                </div>
            </div>
        </div>

        <div class="modal fade" id="delete-column-{{ column.id }}" tabindex="-1" aria-labelledby="delete-column-title-{{ column.id }}" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="delete-column-title-{{ column.id }}">Delete column?</h2>
                        <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0">Only an empty column can be deleted, and every board must keep at least one column</p>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                        <form method="post" action="{{ path('app_board_column_delete', {boardId: board.id, columnId: column.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_column_' ~ column.id) }}">
                            <button class="btn btn-danger" type="submit">Delete column</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}

    <div class="offcanvas offcanvas-end" tabindex="-1" id="card-panel" aria-labelledby="card-panel-title" data-card-panel></div>

    <template data-card-panel-loading-template>
        <div class="offcanvas-header">
            <h2 class="offcanvas-title h5" id="card-panel-title">Card details</h2>
            <button class="btn-close" type="button" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body d-flex align-items-center justify-content-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading card details</span>
            </div>
        </div>
    </template>

    <template data-card-panel-error-template>
        <div class="offcanvas-header">
            <h2 class="offcanvas-title h5" id="card-panel-title">Card details</h2>
            <button class="btn-close" type="button" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="alert alert-danger" role="alert" data-card-panel-error>
                <h3 class="alert-heading h6">Could not load the card</h3>
                <p>Check your connection and try again, or reload the board</p>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-danger" type="button" data-card-panel-retry>Try again</button>
                    <a class="btn btn-outline-danger" href="{{ path('app_board_show', {id: board.id}) }}">Reload board</a>
                </div>
            </div>
        </div>
    </template>

    <template data-quick-create-error-template>
        <div class="alert alert-danger" role="alert" data-quick-create-error>
            <p class="mb-2">Could not create the card. Check your connection and try again</p>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-sm btn-danger" type="button" data-quick-create-retry>Try again</button>
                <a class="btn btn-sm btn-outline-danger" href="{{ path('app_board_show', {id: board.id}) }}">Reload board</a>
            </div>
        </div>
    </template>

    <template data-card-move-error-template>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            Could not move the card. The previous order has been restored
            <a class="alert-link" href="{{ path('app_board_show', {id: board.id}) }}">Reload the board</a>
            <button class="btn-close" type="button" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </template>

    <template data-column-move-error-template>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            Could not reorder the columns. The previous order has been restored
            <a class="alert-link" href="{{ path('app_board_show', {id: board.id}) }}">Reload the board</a>
            <button class="btn-close" type="button" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </template>

    <template data-empty-column-template>
        {% include 'card/_empty_column.html.twig' %}
    </template>
    </div>
{% endblock %}
